/* Modern theme for the character-select scene's per-character name/guild/level tags -- flat,
   semi-transparent rounded backing instead of legacy sprite art. Sized in window points (1rem,
   char_info_balloon.rml's "point-scale" body). */

.balloon {
	position: absolute;
	width: 118rem;
	height: 54rem;
	/* Centred over the point above the character, as the original's (59, 54) anchor. */
	margin-left: -59rem;
	margin-top: -54rem;
	pointer-events: none;
	font-family: "token(font-body)";
	color: token(text-primary);
}
.balloon-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 118rem;
	height: 54rem;
	background-color: rgba(0, 0, 0, 110);
	border: 1rem token(border-frame);
	border-radius: 2rem;
}

.balloon-name, .balloon-guild, .balloon-class {
	position: absolute;
	left: 0;
	width: 118rem;
	text-align: center;
	white-space: nowrap;
	font-size: 12rem;
	font-family: "token(font-body)";
}
.balloon-name {
	top: 6rem;
	font-weight: bold;
	color: token(text-primary);
}
.balloon-guild {
	top: 22rem;
	color: token(text-primary);
}
.balloon-class {
	top: 38rem;
	color: token(accent-gold);
}

/* Name by control status (BalloonNameStatus; the RML toggles .name-<key>). The original
   client's colors; a normal name keeps the .balloon-name color. */
.balloon-name.name-blocked-character { color: #00ffff; }
.balloon-name.name-blocked-items     { color: #ffd927; }
.balloon-name.name-operator          { color: #ff0000; }
